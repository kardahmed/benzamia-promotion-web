NODE_ENV=development
NEXT_PUBLIC_SITE_URL=https://benzamiapromotion.com

# Mesure — cahier des charges V2 §13. Identifiants publics (visibles côté client).
# GTM est le conteneur ; GA4 (G-DS3H6KY8CF) se configure DANS GTM, pas ici.
NEXT_PUBLIC_GTM_ID=GTM-K22BDCXQ
# Meta Pixel : chargé uniquement après consentement « marketing ». Laisser vide
# tant que l'ID n'est pas fourni (le pixel ne se charge alors jamais).
NEXT_PUBLIC_META_PIXEL_ID=

# reCAPTCHA v3 (anti-abus formulaires — CDC §16). Créer une clé « v3 » sur
# https://www.google.com/recaptcha/admin pour le domaine benzamiapromotion.com.
# Vides = vérification désactivée (les formulaires fonctionnent sans).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Visite virtuelle 3DVista. Par défaut : GitHub Pages
# (https://kardahmed.github.io/benzamia-360/index.htm). Renseigner ici pour
# basculer vers un autre hôte (ex. https://visite.benzamiapromotion.com/index.htm) ;
# mettre « off » pour forcer l'état « bientôt disponible ». Voir docs/VISITE-VIRTUELLE.md
NEXT_PUBLIC_VIRTUAL_TOUR_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_URL=

# Intégration CRM commercial — voir docs/CALENDRIER-IMMOPROX.md
# (endpoints de réservation et webhooks non encore opérationnels côté CRM)
IMMOPROX_API_BASE_URL=
IMMOPROX_API_TOKEN=
IMMOPROX_INTEGRATION_ID=
IMMOPROX_WEBHOOK_SECRET=

# E-mails transactionnels (contact + réservation). Vides = mode MVP (rien n'est envoyé).
# Resend : SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASSWORD=<clé API re_...>
# (ou SMTP Hostinger, ou autre). Vérifier SPF/DKIM/DMARC du domaine.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=BENZAMIA Promotion <contact@benzamiapromotion.com>
CONTACT_RECIPIENT=contact@benzamiapromotion.com
# Email de secours si le CRM est indisponible au moment d'une réservation
BOOKING_FALLBACK_EMAIL=contact@benzamiapromotion.com
